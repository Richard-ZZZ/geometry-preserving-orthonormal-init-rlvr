+def patch_vllm_qwen2_packed_weight_loader():
+    try:
+        from vllm.model_executor.model_loader.weight_utils import default_weight_loader, maybe_remap_kv_scale_name
+        from vllm.model_executor.models.qwen2 import Qwen2Model, is_pp_missing_parameter
+    except ImportError:
+        return
+
+    if getattr(Qwen2Model.load_weights, "_verl_accepts_packed_weights", False):
+        return
+
+    def patched_load_weights(self, weights):
+        stacked_params_mapping = [
+            ("qkv_proj", "q_proj", "q"),
+            ("qkv_proj", "k_proj", "k"),
+            ("qkv_proj", "v_proj", "v"),
+            ("gate_up_proj", "gate_proj", 0),
+            ("gate_up_proj", "up_proj", 1),
+        ]
+        params_dict = dict(self.named_parameters(remove_duplicate=False))
+
+        def resolve_param_name(name: str) -> str:
+            candidates = [name, f"model.{name}"]
+            if name.endswith(".weight"):
+                candidates.extend(
+                    [
+                        name.replace(".weight", ".base_layer.weight"),
+                        f"model.{name.replace('.weight', '.base_layer.weight')}",
+                    ]
+                )
+            if name.endswith(".bias"):
+                candidates.extend(
+                    [
+                        name.replace(".bias", ".base_layer.bias"),
+                        f"model.{name.replace('.bias', '.base_layer.bias')}",
+                    ]
+                )
+            for candidate in candidates:
+                if candidate in params_dict:
+                    return candidate
+            suffix_matches = [
+                key
+                for key in params_dict
+                if any(key.endswith(f".{candidate}") or key == candidate for candidate in candidates)
+            ]
+            if len(suffix_matches) == 1:
+                return suffix_matches[0]
+            raise KeyError(name)
+
+        loaded_params = set()
+        for name, loaded_weight in weights:
+            if "rotary_emb.inv_freq" in name:
+                continue
+            if self.quant_config is not None and (scale_name := self.quant_config.get_cache_scale(name)):
+                param = params_dict[resolve_param_name(scale_name)]
+                weight_loader = getattr(param, "weight_loader", default_weight_loader)
+                loaded_weight = loaded_weight if loaded_weight.dim() == 0 else loaded_weight[0]
+                weight_loader(param, loaded_weight)
+                loaded_params.add(scale_name)
+                continue
+
+            already_packed = ".qkv_proj." in name or ".gate_up_proj." in name
+            if not already_packed:
+                for param_name, weight_name, shard_id in stacked_params_mapping:
+                    if weight_name not in name:
+                        continue
+                    name = name.replace(weight_name, param_name)
+                    if name.endswith(".bias") and name not in params_dict:
+                        continue
+                    if is_pp_missing_parameter(name, self):
+                        continue
+                    if name.endswith("scale"):
+                        name = maybe_remap_kv_scale_name(name, params_dict)
+                        if name is None:
+                            continue
+                    resolved_name = resolve_param_name(name)
+                    param = params_dict[resolved_name]
+                    weight_loader = getattr(param, "weight_loader", default_weight_loader)
+                    if weight_loader == default_weight_loader:
+                        weight_loader(param, loaded_weight)
+                    else:
+                        weight_loader(param, loaded_weight, shard_id)
+                    break
+                else:
+                    if name.endswith(".bias") and name not in params_dict:
+                        continue
+                    name = maybe_remap_kv_scale_name(name, params_dict)
+                    if name is None:
+                        continue
+                    if is_pp_missing_parameter(name, self):
+                        continue
+                    resolved_name = resolve_param_name(name)
+                    param = params_dict[resolved_name]
+                    weight_loader = getattr(param, "weight_loader", default_weight_loader)
+                    weight_loader(param, loaded_weight)
+            else:
+                if name.endswith(".bias") and name not in params_dict:
+                    continue
+                if name.endswith("scale"):
+                    name = maybe_remap_kv_scale_name(name, params_dict)
+                    if name is None:
+                        continue
+                if is_pp_missing_parameter(name, self):
+                    continue
+                resolved_name = resolve_param_name(name)
+                param = params_dict[resolved_name]
+                weight_loader = getattr(param, "weight_loader", default_weight_loader)
+                weight_loader(param, loaded_weight)
+            loaded_params.add(name)
+        return loaded_params
+
+    patched_load_weights._verl_accepts_packed_weights = True
+    Qwen2Model.load_weights = patched_load_weights
+
+
