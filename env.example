# Copy to `.env` or export these variables before running scripts.

# Base model
export MODEL_BASE_PATH="/path/to/DeepSeek-R1-Distill-Qwen-1.5B"
export PRETRAINED="${MODEL_BASE_PATH}"

# Dataset files
export TRAIN_FILE="/path/to/dapo-math-17k.parquet"
export TEST_FILE="/path/to/aime-2024.parquet"

# Adapter bundle root. Required for PiSSA/MiLoRA/RLPO/RLMO init adapters.
export BUNDLE_BASE="/path/to/adapter_bundles/deepseek_r1_distill_qwen_1_5b"

# Checkpoint/output root
export CKPT_ROOT="./checkpoints"
export LOG_DIR="./outputs"

# Common reproducibility knobs
export SEED=42
export TRAIN_PROMPT_BSZ=128
export MAX_PROMPT_LENGTH=512
export MAX_RESPONSE_LENGTH=16384

